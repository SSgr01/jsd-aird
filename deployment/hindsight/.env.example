# Copy the required values into your local .env or a private environment file.
# The existing PostgreSQL instance needs PostgreSQL >=15 and pgvector >=0.5.0.
# prepare creates a dedicated database/role; it never runs business Flyway.
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_BASE_URL=
HINDSIGHT_API_LLM_MODEL=
HINDSIGHT_API_LLM_API_KEY=

# Chinese business conversations: do not use the English-only default embedding.
HINDSIGHT_API_EMBEDDINGS_PROVIDER=local
HINDSIGHT_API_EMBEDDINGS_LOCAL_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
HINDSIGHT_API_LLM_MAX_CONCURRENT=2
HINDSIGHT_API_LLM_MAX_RETRIES=1
HINDSIGHT_API_DB_POOL_MIN_SIZE=2
HINDSIGHT_API_DB_POOL_MAX_SIZE=16
# Stable across container recreation; each worker in a multi-worker setup needs its own ID.
HINDSIGHT_API_WORKER_ID=jsd-aird-memory
HINDSIGHT_API_WORKER_MAX_SLOTS=4
