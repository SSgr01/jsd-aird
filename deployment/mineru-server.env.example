# Load these values into BOTH API and Worker; activate prod and worker profiles on Worker.
# Remove smaller -Xmx flags from existing launch commands (command-line flags take precedence).
JAVA_TOOL_OPTIONS=-Xms2g -Xmx16g -XX:+UseG1GC
JSD_AIRD_MINERU_PROVIDER=self-hosted
JSD_AIRD_MINERU_BASE_URL=http://127.0.0.1:8010
JSD_AIRD_MINERU_TIER=advanced
JSD_AIRD_MINERU_DEFAULT_OCR_MODE=ON
JSD_AIRD_MINERU_BATCH_SIZE=8
JSD_AIRD_MINERU_BATCH_CONCURRENCY=2
JSD_AIRD_MINERU_BATCH_WINDOW=500ms
JSD_AIRD_MINERU_BATCH_MAX_BYTES=1073741824
JSD_AIRD_WORKER_CLAIMS_PER_POLL=16
JSD_AIRD_WORKER_DOCUMENT_PROCESSES=4
JSD_AIRD_WORKER_DOCUMENT_PROCESS_HEAP_MIB=2048
JSD_AIRD_WORKER_DOCUMENT_PROCESS_DIRECT_MIB=256
JSD_AIRD_WORKER_DOCUMENT_PROCESS_METASPACE_MIB=256
JSD_AIRD_WORKER_DOCUMENT_PROCESS_CPUS=2
JSD_AIRD_WORKER_DOCUMENT_PROCESS_TIMEOUT=5m
JSD_AIRD_WORKER_POLL_DELAY=500ms
JSD_AIRD_WORKER_KNOWLEDGE_JOB_TIMEOUT=2h
JSD_AIRD_CAPACITY_HEAVY=20
JSD_AIRD_CAPACITY_HEAVY_QUEUE=64
JSD_AIRD_CAPACITY_REQUESTS=96
JSD_AIRD_CAPACITY_REQUEST_QUEUE=128
JSD_AIRD_CAPACITY_WRITES=16
JSD_AIRD_CAPACITY_STREAMS=48
JSD_AIRD_CAPACITY_ADMISSION_MILLIS=2000
JSD_AIRD_CAPACITY_HEAVY_MILLIS=600000
JSD_AIRD_CAPACITY_TEMPORARY_BYTES=34359738368
JSD_AIRD_CAPACITY_PENDING_JOBS=2000
JSD_AIRD_CAPACITY_ORGANIZATION_PENDING_JOBS=1000
JSD_AIRD_DB_MAXIMUM_POOL_SIZE=32
