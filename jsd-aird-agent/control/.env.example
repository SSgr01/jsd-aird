# Native PostgreSQL only: never point this service at the business database.
JSD_AIRD_AGENTS_DATABASE_URL=postgresql://agents_dev@127.0.0.1:55439/jsd_aird_agents_dev
# Generate random tokens with: python -m jsd_aird_agents demo-env --database-url <agents-dsn>
JSD_AIRD_AGENTS_ACTOR_TOKEN=replace-with-a-random-actor-token
JSD_AIRD_AGENTS_APPROVER_TOKEN=replace-with-a-different-approver-token
JSD_AIRD_AGENTS_OUTSIDER_TOKEN=replace-with-a-different-outsider-token
# Fixed monitoring needs no model. Use scripted for offline Agent demos, or openai_compatible for a provider.
JSD_AIRD_AGENTS_MODEL_BACKEND=disabled
JSD_AIRD_AGENTS_HOST=127.0.0.1
JSD_AIRD_AGENTS_PORT=8091
JSD_AIRD_AGENTS_DOMAIN_BACKEND=mock
# Optional explicit skill roots (JSON array); default is the registered packs' skills directories.
# Personal Codex skills and scripts are never automatically imported or executed.
# JSD_AIRD_AGENTS_SKILL_ROOTS=["D:/Projects/IdeaProjects/jsd-aird/.agents/skills"]
# JSD_AIRD_AGENTS_MAX_SELECTED_SKILLS=3
# Real model settings override legacy JSD_AIRD_MODEL_* values.
# JSD_AIRD_AGENTS_MODEL_BASE_URL=https://your-provider.example/v1
# JSD_AIRD_AGENTS_MODEL_API_KEY=
# JSD_AIRD_AGENTS_MODEL_NAME=
# JSD_AIRD_AGENTS_MODEL_STRUCTURED_METHOD=function_calling
# Reasoning providers may require a larger output allowance and timeout:
# JSD_AIRD_AGENTS_MODEL_MAX_OUTPUT_TOKENS=8192
# JSD_AIRD_AGENTS_MODEL_TIMEOUT_SECONDS=90
# Optional Qwen-only extension; omitted by default, never inferred from the model name:
# JSD_AIRD_AGENTS_MODEL_ENABLE_THINKING=false

# Shared platform context and scheduler polling:
# JSD_AIRD_AGENTS_CONTEXT_TOKENS=4000
# JSD_AIRD_AGENTS_SCHEDULER_POLL_SECONDS=1
