# Separate control service. Never put this file in a model workspace.
JSD_AIRD_HARNESS_DATABASE_URL=postgresql://agents_dev@127.0.0.1:55449/jsd_aird_agents_dev
JSD_AIRD_HARNESS_SHARED_SECRET=
JSD_AIRD_HARNESS_RUNTIME_SECRET=
JSD_AIRD_HARNESS_JAVA_URL=http://127.0.0.1:8080
JSD_AIRD_HARNESS_RUNTIME_URL=http://127.0.0.1:8092
JSD_AIRD_HARNESS_STORAGE_ROOT=.runtime/harness
JSD_AIRD_HARNESS_SANDBOX_ENABLED=false
JSD_AIRD_HARNESS_SANDBOX_URL=http://127.0.0.1:8094
JSD_AIRD_HARNESS_SANDBOX_SECRET=
JSD_AIRD_HARNESS_PAPERQA_MODEL=
JSD_AIRD_HARNESS_PAPERQA_BASE_URL=
JSD_AIRD_HARNESS_PAPERQA_API_KEY=
# Optional provider-specific switch; only set it for a provider/model that accepts this parameter.
# JSD_AIRD_HARNESS_PAPERQA_ENABLE_THINKING=false
JSD_AIRD_HARNESS_REPORT_REVIEW_TIMEOUT_SECONDS=120
# Citation-only repair is bounded separately from the overall task budget.
# Model requests: 1–2; targeted reads of existing sources: 0–2.
JSD_AIRD_HARNESS_CITATION_REPAIR_MODEL_CALLS=2
JSD_AIRD_HARNESS_CITATION_REPAIR_TOOL_CALLS=2
# Request stages are logged outside model context; no request bodies or secrets.
JSD_AIRD_HARNESS_STAGE_TIMING=false
# Admission is durable; omitted organization limit follows the global limit.
# The global limit keeps its existing default/configuration.
JSD_AIRD_HARNESS_MAX_RUNNING_RUNS_PER_USER=2
JSD_AIRD_HARNESS_ADMISSION_HEARTBEAT_SECONDS=10
JSD_AIRD_HARNESS_ADMISSION_LEASE_SECONDS=60
