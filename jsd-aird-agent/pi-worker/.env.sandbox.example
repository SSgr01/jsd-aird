# Broker-only environment: do not give it business DB or model credentials.
JSD_AIRD_SANDBOX_TOKEN=
JSD_AIRD_SANDBOX_WORKSPACE_ROOT=G:/Projects/jsd-aird/.runtime/harness/workspaces
JSD_AIRD_SANDBOX_IMAGE=jsd-aird-analysis:1
JSD_AIRD_SANDBOX_TIMEOUT_SECONDS=120
JSD_AIRD_SANDBOX_PARALLELISM=4
# Optional hardened runtime, which must actually be installed and validated:
# JSD_AIRD_SANDBOX_OCI_RUNTIME=runsc
