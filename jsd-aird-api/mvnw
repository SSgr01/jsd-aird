#!/bin/sh
set -eu

MAVEN_VERSION="3.9.9"
MAVEN_DIST_URL="https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/${MAVEN_VERSION}/apache-maven-${MAVEN_VERSION}-bin.zip"
MAVEN_CACHE="${MAVEN_USER_HOME:-${HOME}/.m2}/wrapper/dists/apache-maven-${MAVEN_VERSION}"
MAVEN_HOME="${MAVEN_CACHE}/apache-maven-${MAVEN_VERSION}"

if [ ! -x "${MAVEN_HOME}/bin/mvn" ]; then
  mkdir -p "${MAVEN_CACHE}"
  ARCHIVE="${MAVEN_CACHE}/apache-maven-${MAVEN_VERSION}-bin.zip"

  if command -v curl >/dev/null 2>&1; then
    curl -fsSL "${MAVEN_DIST_URL}" -o "${ARCHIVE}"
  elif command -v wget >/dev/null 2>&1; then
    wget -q "${MAVEN_DIST_URL}" -O "${ARCHIVE}"
  else
    echo "ERROR: curl or wget is required to download Maven ${MAVEN_VERSION}." >&2
    exit 1
  fi

  if command -v unzip >/dev/null 2>&1; then
    unzip -q -o "${ARCHIVE}" -d "${MAVEN_CACHE}"
  else
    echo "ERROR: unzip is required to extract Maven ${MAVEN_VERSION}." >&2
    exit 1
  fi
fi

exec "${MAVEN_HOME}/bin/mvn" "$@"

